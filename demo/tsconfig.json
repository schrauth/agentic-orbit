{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "engine.ts",
    "main.ts",
    "../types/index.d.ts",
    "../hooks/setup.ts",
    "../hooks/palette.ts",
    "../hooks/classify.ts",
    "../hooks/draw.ts",
    "../hooks/feed.ts",
    "../hooks/text.ts",
    "../vscode-extension/src/board.ts",
    "../vscode-extension/src/classifyCopilot.ts"
  ]
}
